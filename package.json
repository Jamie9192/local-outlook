{
  "name": "local-outlook",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "desktop": "node scripts/desktop.mjs",
    "test": "vitest run && node --test scripts/check-version-tests.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "check:version": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jamie9192/local-outlook.git"
  }
